# ================================================================================
# Planka Configuration
# ================================================================================

# --- Planka URL ------------------------------------------------------------------
PLANKA_BASE_URL=https://planka.example.com

# --- Agent (LLM) Credentials -----------------------------------------------------
# Preferred for Planka v2 service integrations. When set, email/password are not used.
# PLANKA_API_KEY=your_user_api_key_here

# Password fallback (kept for backwards compatibility)
PLANKA_AGENT_EMAIL=agent@example.com
PLANKA_AGENT_PASSWORD=your_password_here

# --- Read-only attachment downloads ---------------------------------------------
# Comma-separated additional HTTPS origins for S3-backed file attachments.
# PLANKA_ATTACHMENT_ALLOWED_ORIGINS=https://s3.example.com
# PLANKA_ATTACHMENT_TIMEOUT_MS=30000

# --- Admin (optional, for specific operations) ------------------------------------
# You may optionally specify either Email or ID (not required, choose one if needed)
PLANKA_ADMIN_EMAIL=admin@example.com
# PLANKA_ADMIN_ID=0000000000000000000

# --- Connection Settings ----------------------------------------------------------
PLANKA_IGNORE_SSL=true
